<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Renewal Desk" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag :app %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <% if current_user %>
          <%= link_to root_path, class: "brand" do %>
            <span class="brand-mark" aria-hidden="true">R</span>
            <span>Renewal Desk</span>
          <% end %>
          <div class="account">
            <span class="account-email"><%= current_user.email_address %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "button button--quiet" %>
          </div>
        <% else %>
          <div class="brand">
            <span class="brand-mark" aria-hidden="true">R</span>
            <span>Renewal Desk</span>
          </div>
        <% end %>
      </div>
    </header>

    <main id="main" class="shell main-content">
      <% if notice %>
        <p class="notice" role="status"><%= notice %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
