<% content_for :title, "Contracts · Renewal Desk" %>

<div class="page-heading">
  <div>
    <h1>Contracts</h1>
    <p class="muted">Track notice deadlines and review renewal decisions.</p>
  </div>
  <%= link_to "New contract", new_contract_path, class: "button button--primary" %>
</div>

<section class="panel contract-list" aria-label="Contract list">
  <nav class="tabs" aria-label="Filter contracts">
    <% { "open" => "Open", "decided" => "Decided", "all" => "All" }.each do |filter, label| %>
      <%= link_to label, contracts_path(view: filter), aria: { current: (@view == filter ? "page" : nil) } %>
    <% end %>
  </nav>

  <% if @contracts.load.empty? %>
    <p class="empty-state"><%= { "open" => "No open contracts.", "decided" => "No renewal decisions yet.", "all" => "No contracts yet." }.fetch(@view) %></p>
  <% else %>
    <div class="table-wrap">
      <table class="contracts-table">
        <thead>
          <tr>
            <th scope="col">Contract</th>
            <th scope="col">Ends on</th>
            <th scope="col">Notice deadline</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @contracts.each do |contract| %>
            <tr>
              <th scope="row">
                <%= link_to contract.title, contract_path(contract), class: "contract-link" %>
                <span class="counterparty"><%= contract.counterparty %></span>
              </th>
              <td><span class="cell-label" aria-hidden="true">Ends on</span><%= contract_date(contract.ends_on) %></td>
              <td><span class="cell-label" aria-hidden="true">Notice deadline</span><%= contract_date(contract.notice_due_on) %></td>
              <td class="status-cell"><%= contract_badge(contract) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
